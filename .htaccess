# Shrikaa — Apache / BigRock rewrite rules
# Extensionless URLs: /about → about.html

Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 301 Redirects for renamed pages
  RewriteRule ^puc-coaching-jayanagar(\.html)?$ /puc-coaching [R=301,L]
  RewriteRule ^cet-coaching-bengaluru(\.html)?$ /cet-coaching [R=301,L]
  RewriteRule ^neet-coaching-bengaluru(\.html)?$ /neet-coaching [R=301,L]
  RewriteRule ^jee-coaching-bengaluru(\.html)?$ /jee-coaching [R=301,L]

  # Force HTTPS (uncomment if SSL is active and host supports it)
  # RewriteCond %{HTTPS} off
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Prefer www
  # RewriteCond %{HTTP_HOST} ^shrikaa\.co\.in$ [NC]
  # RewriteRule ^ https://www.shrikaa.co.in%{REQUEST_URI} [L,R=301]

  # Serve existing files/dirs as-is
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Extensionless → .html
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# Compress text responses when the Apache module is available.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

# Security / caching basics for static hosting
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/ttf "access plus 1 year"
</IfModule>
